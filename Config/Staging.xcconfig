#include "Base.xcconfig"

// A Release-grade build that talks to the development project, so staging can
// be tested through TestFlight by people who do not have Xcode.
//
// Deliberately NOT reachable from the default scheme. Archiving `Sirr` gives
// production; archiving `Sirr (Staging)` gives this. Keeping them on separate
// schemes is what stops a staging binary being uploaded by accident.

// Its own bundle id, so this is a separate app everywhere it matters: a
// separate App Store Connect record, a separate TestFlight, a separate icon on
// the home screen, and separate storage — installing staging can no longer
// overwrite a tester's production install or its keychain and defaults.
//
// Written out in full rather than derived from Local.xcconfig: it overrides
// whatever that gitignored file sets, so staging is the same app on every
// machine and nobody has to edit their local copy to build it.
PRODUCT_BUNDLE_IDENTIFIER = com.businessech.tmrin.staging

// Deliberately no SUPABASE_HOST or SUPABASE_ANON_KEY. The sandbox endpoint is
// compiled into SupabaseEnvironment under `#if STAGING` instead, so a staging
// binary cannot be pointed anywhere else by an xcconfig edit. Leaving the keys
// undefined means the built Info.plist carries them as empty strings, so the
// `!raw.isEmpty` guard in SupabaseEnvironment turns any future removal of that
// `#if` into a crash at launch rather than a build talking to nothing.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) STAGING

// The home-screen name is the last line of defence: whatever else is
// misconfigured, a tester can see at a glance which app they opened.
INFOPLIST_KEY_CFBundleDisplayName = تمرين STG

// Version and build number are inherited from Base. They used to be forced to
// 99.0 because staging shared production's App Store Connect record, where one
// version train is shared and a staging build number would block a real one.
// With a record of its own the trains are already independent, so staging can
// carry the version it is actually testing.
