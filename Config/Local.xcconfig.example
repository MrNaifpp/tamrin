// Copy this file to Config/Local.xcconfig and fill in your own values.
//
// Config/Local.xcconfig is gitignored — it is the reason project.pbxproj no
// longer carries anyone's personal signing settings, and therefore the reason
// the project file can finally be committed.
//
// Find your team id at developer.apple.com ▸ Membership.
//
// This id is used by Debug and Release. Staging.xcconfig hardcodes its own
// (`com.businessech.tmrin.staging`) and ignores whatever is set here.
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER =
TAMRIN_LIVE_ACTIVITY_BUNDLE_IDENTIFIER =

// Optional free Personal Team support, Debug only. Uncomment both together.
// TAMRIN_DEBUG_ENTITLEMENTS = Sirr/PersonalTeam.entitlements
// TAMRIN_DEBUG_SWIFT_FLAGS = TAMRIN_PERSONAL_TEAM
