// Settings shared by every configuration.
//
// Per-developer signing lives in Local.xcconfig, which is gitignored because
// Naif and Faris sign with different teams and bundle ids. The `?` makes the
// include non-fatal, so a fresh clone still builds — it just will not sign
// until the developer creates their own copy from Local.xcconfig.example.
#include? "Local.xcconfig"

// Version lives here, not in the target, so a bump is tracked in git. It used
// to sit only in Naif's working copy of project.pbxproj, which meant an
// archive from Faris's machine would have silently shipped 1.0 (1).
// 1.1 (2) was released on 2026-08-01 and points at the sandbox, so it must be
// superseded. A released version's train is closed to new builds — uploading
// another build to 1.1 fails with "Invalid Pre-Release Train" — so the first
// production-backed build is a new version, not a new build number.
MARKETING_VERSION = 1.7
// Build numbers are what App Store Connect rejects duplicates on, not the
// marketing version — and they are only compared within one version train.
// 1.6 spent (2) through (8): (2) was uploaded, (3) predates the rating repair,
// (4) the details-page and lineup-permission fixes, (5) the exercise actions
// menu, and (8) predates the exercise ever becoming visible — every event
// created by a build before this one is invisible to its own group, because
// there was no way to publish one.
//
// 1.7 is a new train, so its numbering starts again with none of 1.6's numbers
// in the way. (1) was the first sandbox-backed archive; (2) is the one that
// carries the day an owed exercise gets to itself, and the shelf back to a
// plain poster with تخطي moved to the exercise's own menu.
CURRENT_PROJECT_VERSION = 2

// Here rather than in the target so Staging.xcconfig can override it — a
// staging build on the home screen has to be tellable from a real one.
//
// This only worked once the same key was deleted from the target's build
// settings in project.pbxproj: a target-level value beats a project-level
// xcconfig, which is why staging silently read تمرين instead of تمرين STG for
// as long as both existed. Editing the display name in Xcode's General or
// Build Settings tab writes it back to the target and breaks this again — set
// it here instead.
INFOPLIST_KEY_CFBundleDisplayName = تمرين
