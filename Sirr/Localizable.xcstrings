    "سنجهّز البطاقة بمقاس %@. في هذه النسخة اختر %@ من ورقة المشاركة، أو احفظ الصورة واستخدمها في الستوري." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "سنجهّز البطاقة بمقاس %1$@. في هذه النسخة اختر %2$@ من ورقة المشاركة، أو احفظ الصورة واستخدمها في الستوري."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll size the card at %1$@. For now, pick %2$@ from the share sheet, or save the image and use it in your story."
          }
        }
      }
    },
    "سيؤكد صاحب الفعالية الدفعة، وستظهر لك بحالة \"مؤكد\"." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The admin will confirm your payment and it will show as \"Confirmed\"."
          }
        }
      }
    },
    "سياسة الاكتمال" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When Full"
          }
        }
      }
    },
    "سيُحذف حسابك وكل بياناتك: تمارينك، مواعيدك، تسجيلاتك ومدفوعاتك. لا يمكن التراجع عن هذا الإجراء." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account and all your data will be deleted: your groups, sessions, registrations, and payments. This can't be undone."
          }
        }
      }
    },
    "سيُزال %@ من المجموعة وتختفي مواعيدها من عنده." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will be removed from the group and its sessions will disappear from their list."
          }
        }
      }
    },
    "سيُزال %@ من قائمة «%@» ويتحرر مقعده." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "سيُزال %1$@ من قائمة «%2$@» ويتحرر مقعده."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ will be removed from “%2$@” and their spot will open up."
          }
        }
      }
    },
    "سيصل تنبيه للاعبين المسجلين. يستمر التصويت 24 ساعة، ولا يمكن تغيير المرشحين بعد النشر." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registered players will be notified. Voting lasts 24 hours, and the nominees can't be changed after publishing."
          }
        }
      }
    },
    "سيصله تنبيه بأن القطة ما وصلت، ويظهر له زر دفع القطة مجددًا. يبقى مكانه ومقاعد ضيوفه محفوظة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They'll be notified that their split didn't arrive, and the Pay Split button will show again. Their spot and their guests' spots stay reserved."
          }
        }
      }
    },
    "سيظهر الاسم والرياضة والتفاصيل الجديدة في المواعيد القادمة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new name, sport, and details will apply to upcoming sessions."
